<div class="reading-progress" data-reading-progress aria-hidden="true">
  <span></span>
</div>

<div class="article-layout">
  <article class="article" id="article-top">
    <header class="article-header">
      <p class="eyebrow">
        <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
        <% if (page.categories && page.categories.length) { %>
          <span>/</span>
          <% page.categories.each(function(category) { %>
            <a href="<%- url_for(category.path) %>"><%= category.name %></a>
          <% }) %>
        <% } %>
      </p>
      <h1><%= page.title %></h1>
      <% if (page.excerpt) { %>
        <p class="article-summary"><%= strip_html(page.excerpt) %></p>
      <% } %>
      <div class="article-stats" aria-label="Article stats">
        <span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
          总浏览量
          <strong id="busuanzi_value_page_pv">--</strong>
        </span>
        <span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8z"/></svg>
          评论区
        </span>
      </div>
    </header>

    <div class="article-content">
      <%- page.content %>
    </div>

    <% if (page.tags && page.tags.length) { %>
      <footer class="article-tags">
        <% page.tags.each(function(tag) { %>
          <a href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
        <% }) %>
      </footer>
    <% } %>

    <nav class="back-home" aria-label="Back home">
      <a href="<%- url_for('/') %>">← 返回首页</a>
    </nav>

    <% var comments = theme.comments || {}; %>
    <% var giscusReady = comments.enabled && comments.repo && comments.repo_id && comments.category_id; %>
    <section class="comments-panel" aria-label="Comments">
      <header>
        <span>Discuss</span>
        <h2>读者评论</h2>
      </header>
      <% if (giscusReady) { %>
        <script src="https://giscus.app/client.js"
          data-repo="<%= comments.repo %>"
          data-repo-id="<%= comments.repo_id %>"
          data-category="<%= comments.category || 'General' %>"
          data-category-id="<%= comments.category_id %>"
          data-mapping="<%= comments.mapping || 'pathname' %>"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="<%= comments.theme || 'transparent_dark' %>"
          data-lang="<%= comments.lang || 'zh-CN' %>"
          crossorigin="anonymous"
          async>
        </script>
      <% } else { %>
        <p class="comments-note">评论区将在站点仓库绑定后开启。</p>
      <% } %>
    </section>
  </article>

  <aside class="article-toc" data-article-toc aria-label="Article table of contents">
    <h2>目录</h2>
    <nav data-toc-list></nav>
  </aside>
</div>
